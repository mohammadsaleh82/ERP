# ------------------------------------------------------------------------------
# ERP Environment Configuration Template
# ------------------------------------------------------------------------------

# Application Environment (Development | Staging | Production)
APP_ENV=Production

# PostgreSQL Database Configuration
POSTGRES_DB=erp_db
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=replace_with_a_very_strong_random_password_in_prod

# JWT Authentication Configuration
JWT_ISSUER=ERP.Api
JWT_AUDIENCE=ERP.Client
JWT_SECRET=replace_with_at_least_32_bytes_random_crypto_secret_key!
JWT_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# Nginx & Domain Configuration
SERVER_NAME=erp.yourcompany.com
